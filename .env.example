# ============================================================================
# Jugnu — environment
# Copy to .env and edit. Every value below has a working default, so an empty
# .env still runs.
# ============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# development | production | test
# In production the app refuses to start with the default SECRET_KEY.
ENVIRONMENT=development

# Signing key for JWTs. MUST be changed in production.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-in-production

# How long an access token stays valid, in minutes.
ACCESS_TOKEN_MINUTES=10080

# bcrypt cost factor. 12 is a good default; 4 is fine for tests.
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./jugnu.db

# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://jugnu:jugnu@localhost:5432/jugnu

# Echo SQL to stdout. Useful when debugging, noisy otherwise.
SQL_ECHO=false

# ---------------------------------------------------------------------------
# Search providers
# ---------------------------------------------------------------------------

# Comma-separated, in priority order. Results from all of them are merged.
#   wikipedia  — no key needed, encyclopedic coverage
#   duckduckgo — no key, but often blocks datacenter IPs
#   tavily     — needs TAVILY_API_KEY, broad web coverage
#   searxng    — needs SEARXNG_URL, self-hosted and private
SEARCH_PROVIDERS=wikipedia

# Tavily API key. Free tier available at https://tavily.com
TAVILY_API_KEY=

# Base URL of your SearXNG instance. It must have `format: json` enabled.
# SEARXNG_URL=http://localhost:8888

# How many sources to retrieve per search.
MAX_SOURCES=6

# How many of those to actually fetch and read. The rest keep their snippet.
MAX_FETCH=4

# Per-request timeout for provider and page fetches, in seconds.
FETCH_TIMEOUT_SECONDS=8

# Max concurrent page fetches. Keep this modest — you are a guest on those sites.
FETCH_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Answer synthesis
# ---------------------------------------------------------------------------

# extractive — quotes real sentences, cannot invent a citation, no key needed
# openai     — fluent prose, needs OPENAI_API_KEY
# anthropic  — fluent prose, needs ANTHROPIC_API_KEY
ANSWER_PROVIDER=extractive

# Only used when ANSWER_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only used when ANSWER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Max sentences in an extractive answer.
MAX_ANSWER_SENTENCES=4

# ---------------------------------------------------------------------------
# Cache
# ---------------------------------------------------------------------------

# How long a search result stays cached, in seconds. 0 disables the cache.
CACHE_TTL_SECONDS=900

# Max cached searches held in memory per worker.
CACHE_MAX_ENTRIES=512

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------

# Set to false for local development or load testing.
RATE_LIMIT_ENABLED=true

# Requests per minute, per identity.
RATE_LIMIT_SEARCH=20
RATE_LIMIT_AUTH=10
RATE_LIMIT_WRITE=60

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated origins allowed to call the API from a browser.
# Leave empty when the frontend is served by this same app (the default).
# CORS_ORIGINS=https://jugnu.example.com,https://www.jugnu.example.com

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
